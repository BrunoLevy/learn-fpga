#mappings for FemtoRV
set_io pclk 15 # SYSCLK

set_io D1 40   #//LED1
set_io D2 1    #//GPIO1.5
set_io D3 2    #//GPIO1.7
set_io D4 3    #//GPIO1.9
set_io D5 51   #//LED2


#pin out TXD=36 RXD=37 allows DIO.UEXT header to work for uart
#crossed pair
#pizero_w icetool1k.local header outside row 4th{tx}=WHT 5th={rx}GRY
#GPIO1 bottom row 7th=WHT 8th=GRY
#UEXT.3{TxD}=GRY UEXT.4{RxD}=WHT

set_io TXD 36
set_io RXD 37

set_io spi_cs_n 49
set_io spi_miso 46
set_io spi_mosi 45
set_io spi_clk  48

set_io RESET      42 #//BUT2 allocate button near xtal as reset
#set_io BUT1	K11 #//not assigned in FemtoRV yet
set_io buttons[0] 41 #//BUT1 is to be USER button on fpga pcb
set_io buttons[1] 24  #//this is temporary to get synthesis to work
#set_io BUT2	P13 #//have allocated to RESET

#set_io LED1	40
#set_io LED2	51



