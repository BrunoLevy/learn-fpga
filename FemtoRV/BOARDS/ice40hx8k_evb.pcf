# map of currently assigned pads
# D1 -> LED1
# D5 -> LED2

# RESET -> BUT2

# TXD T16 -> UEXT TX
# RXD L11 -> UEXT RX
#
# BUT1 AND BUT2 mapped, BUT1 is onboard FPGA pcb

#//recommended waveshare oled loom colours follow
                       #// RED 3V3 DIO.GPIO_out1.3	
                       #// BLK GND DIO.GPIO_out1.4
set_io oled_DIN B1     #// BLU     DIO.GPIO_out1.11
set_io oled_CLK C1     #// YEL     DIO.GPIO_out1.13
set_io oled_CS  C2     #// ORG     DIO.GPIO_out1.15
set_io oled_DC  F4     #// GRN     DIO.GPIO_out1.17
set_io oled_RST D2     #// WHT     DIO.GPIO_out1.19


#//recommended led matrix
                       #// ??? 3V3 DIO.EXT?	
                       #// ??? GND DIO.EXT?
set_io ledmtx_DIN G5   #// ???     DIO.GPIO_out1.21
set_io ledmtx_CS  D1   #// ???     DIO.GPIO_out1.23
set_io ledmtx_CLK G4   #// ???     DIO.GPIO_out1.25


##compact-gpio bitbang on UEXT
##next three sucessfully used for bitbang spi bb_max7219
##pin you have to be careful about pin mapping work from 0 up to n-1 for the number of pins up to 8 allocated
##minimum is 2 pins
#currenly will clash with icezero pmod order allocated in software if UEXT order is adpopted and we can't
#accomodate physical pin numbering of UEXT anyway
#pinout assignment for UEXT I2C+SPI I/O
set_io gpio_pin_val[4]   H2      # bitbang for SDA
set_io gpio_pin_val[5]   J4      # bitbang for SCL
set_io gpio_pin_val[2]   G2      # bitbang ledmtx_DIN  MOSI  
set_io gpio_pin_val[3]   H4      # bitbang MISO 
set_io gpio_pin_val[0]   F1      # bitbang ledmtx_CLK  SCLK  
set_io gpio_pin_val[1]   H6      # bitbang ledmtx_CS   SS    


