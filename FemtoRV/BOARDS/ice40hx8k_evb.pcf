#mappings for FemtoRV
set_io pclk J3

set_io D1 M12   #//LED1
set_io D2 E4    #//GPIO1.5
set_io D3 B2    #//GPIO1.7
set_io D4 F5    #//GPIO1.9
set_io D5 R16   #//LED2

#The following note is probably wrong I assume it was being used at
#too high a baudrate but I don't have the physical hardware to confirm

# UART communication doesn't work when Olimexino 32U4 is used as a bridge
# which forwards the communication to a PC
# (https://www.olimex.com/wiki/ICE40HX1K-EVB#Get_started_under_Linux).
# There might be a bug in Olimexino's firmware, as UART works with a UART-USB
# converter.
set_io TXD T16
set_io RXD L11

set_io spi_cs_n R12
set_io spi_miso P11
set_io spi_mosi P12
set_io spi_clk  R11

set_io RESET    P13 #//BUT2 allocate button near xtal as reset
#set_io BUT1	K11 #//not assigned in FemtoRV yet
set_io buttons[0] K11 #//BUT1 is to be USER button on fpga pcb
set_io buttons[1] F3  #//this is temporary to get synthesis to work
#set_io BUT2	P13 #//have allocated to RESET

#set_io LED1	M12
#set_io LED2	R16



