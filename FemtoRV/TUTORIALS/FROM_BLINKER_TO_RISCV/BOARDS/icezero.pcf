set_io TXD   112 #-pullup yes

set_io SPIFLASH_CS_N 71
set_io SPIFLASH_MISO 68
set_io SPIFLASH_MOSI 67
set_io SPIFLASH_CLK  70

set_io SPIFLASH_IO[0] 67
set_io SPIFLASH_IO[1] 68


set_io RESET    47

